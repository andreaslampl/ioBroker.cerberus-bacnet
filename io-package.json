{
  "common": {
    "name": "cerberus-bacnet",
    "version": "0.1.4",
    "news": {
      "0.1.4": {
        "en": "Title now starts with FC20",
        "de": "Titel beginnt jetzt mit FC20"
      },
      "0.1.3": {
        "en": "Panel extended or reconfigured: new objects are read automatically (database revision); a slower poll no longer overwrites a newer change notification",
        "de": "Zentrale erweitert oder umkonfiguriert: neue Objekte werden automatisch eingelesen (Datenbank-Revision); eine langsamere Abfrage überschreibt keine neuere Änderungsmeldung mehr"
      },
      "0.1.2": {
        "en": "Diagnosis in the log when the panel refuses; optional registration as foreign device (BBMD) for panels in another subnet/VLAN",
        "de": "Diagnose im Log, wenn die Zentrale ablehnt; optional Anmeldung als Foreign Device (BBMD) für Zentralen in einem anderen Subnetz/VLAN"
      },
      "0.1.1": {
        "en": "Announces itself to the panel (I-Am, also across VLANs) so the panel accepts it as its BACnet client; clearer error messages",
        "de": "Meldet sich direkt bei der Zentrale an (I-Am, auch über VLAN-Grenzen), damit sie den Adapter als BACnet-Klient akzeptiert; verständlichere Fehlermeldungen"
      },
      "0.1.0": {
        "en": "Initial release: Cerberus PRO fire panel over BACnet/IP (read, optional commands)",
        "de": "Erste Version: Cerberus-PRO-Brandmeldezentrale über BACnet/IP (lesen, optional schalten)"
      }
    },
    "titleLang": {
      "en": "FC20 Cerberus PRO fire panel (BACnet)",
      "de": "FC20 Cerberus PRO Brandmeldezentrale (BACnet)"
    },
    "desc": {
      "en": "Siemens Cerberus PRO fire panels (FC20/FC720) over BACnet/IP: detectors, zones, alarms, faults, disablements; optional reset, silence, enable/disable and outputs.",
      "de": "Siemens Cerberus PRO Brandmeldezentralen (FC20/FC720) über BACnet/IP: Melder, Zonen, Alarme, Störungen, Abschaltungen; optional Rücksetzen, Akustik ab, Ab-/Einschalten und Ausgänge."
    },
    "authors": [
      "andreaslampl"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "icon": "cerberus-bacnet.png",
    "extIcon": "https://raw.githubusercontent.com/andreaslampl/ioBroker.fc20-cerberus-bacnet/main/admin/cerberus-bacnet.png",
    "readme": "https://github.com/andreaslampl/ioBroker.fc20-cerberus-bacnet/blob/main/README.md",
    "enabled": true,
    "type": "alarm",
    "compact": true,
    "connectionType": "local",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "tier": 2,
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ]
  },
  "native": {
    "host": "",
    "deviceId": 1,
    "clientId": 10,
    "localPort": 47808,
    "bind": "",
    "pollInterval": 30,
    "timeout": 6,
    "allowControl": false,
    "priority": 8,
    "foreignDevice": false
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": {
          "en": "Information",
          "de": "Information"
        }
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": {
          "en": "Panel connected",
          "de": "Zentrale verbunden"
        },
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.panel",
      "type": "state",
      "common": {
        "name": {
          "en": "Panel",
          "de": "Zentrale"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "info.objectTypes",
      "type": "state",
      "common": {
        "name": {
          "en": "BACnet object types (count per type)",
          "de": "BACnet-Objekttypen (Anzahl je Typ)"
        },
        "type": "string",
        "role": "json",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
